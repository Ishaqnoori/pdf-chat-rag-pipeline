# Deployment: paste these into the host's Secrets box (Streamlit Cloud > App settings > Secrets).
# Locally, API keys can stay in .env, but the [auth] section MUST be in .streamlit/secrets.toml.
GOOGLE_API_KEY = "your_google_api_key_here"
GROQ_API_KEY = "your_groq_api_key_here"
FIREBASE_API_KEY = "your_firebase_web_api_key_here"

# --- Continue with Google (optional) ---
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # deployed: https://<your-app>.streamlit.app/oauth2callback
cookie_secret = "paste-a-long-random-string-here"      # python -c "import secrets; print(secrets.token_urlsafe(32))"

[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
