# Copy to .env (never commit .env). Get keys from:
#   Gemini:   https://aistudio.google.com  > API keys
#   Groq:     https://console.groq.com     > API Keys
#   Firebase: console.firebase.google.com  > Project settings > Your apps > Config > apiKey
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
FIREBASE_API_KEY=your_firebase_web_api_key_here

# Optional model overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Usage limits that protect your API quota (defaults shown; raise them after upgrading a plan)
# LIMIT_QUESTIONS_PER_USER_DAY=100
# LIMIT_UPLOADS_PER_USER_DAY=20
# LIMIT_APP_QUESTIONS_PER_MINUTE=20
# LIMIT_APP_QUESTIONS_PER_DAY=800
# LIMIT_APP_UPLOADS_PER_DAY=150
# MAX_ANSWER_TOKENS=2048
# GROQ_REWRITE_MODEL=openai/gpt-oss-20b
# Scanned PDFs (text recognition through Gemini)
# GEMINI_OCR_MODEL=gemini-3.6-flash
# LIMIT_SCANS_PER_USER_DAY=5
# LIMIT_APP_SCANS_PER_DAY=40
# Daily questions per model, per user and for the whole app (each model has its own Groq quota;
# set the app-wide numbers a little below each model's requests-per-day in the Groq console)
# LIMIT_MODEL_GPT_OSS_120B=50
# LIMIT_MODEL_GPT_OSS_20B=100
# LIMIT_MODEL_QWEN_27B=50
# LIMIT_APP_MODEL_GPT_OSS_120B=500
# LIMIT_APP_MODEL_GPT_OSS_20B=1000
# LIMIT_APP_MODEL_QWEN_27B=500
# Gemini answer models use your GOOGLE_API_KEY (Google's quota is separate from Groq's)
# LIMIT_MODEL_GEMINI_36_FLASH=30        LIMIT_APP_MODEL_GEMINI_36_FLASH=200
# LIMIT_MODEL_GEMINI_25_FLASH=30        LIMIT_APP_MODEL_GEMINI_25_FLASH=200
# LIMIT_MODEL_GEMINI_25_FLASH_LITE=50   LIMIT_APP_MODEL_GEMINI_25_FLASH_LITE=400

# Owner-only Admin page (Settings > Admin): comma-separated emails
# ADMIN_EMAILS=you@example.com

# Error alerts by email (free Sentry plan): sentry.io > Projects > Client Keys (DSN)
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# Shown on the Privacy and Terms pages (defaults to the first ADMIN_EMAILS address)
# CONTACT_EMAIL=you@example.com

# Sessions: days a "keep me signed in" login lasts (0 turns the option off)
# SESSION_DAYS=3
# Proxies you control in front of the app (Streamlit Cloud or Caddy = 1); used for per-network limits
# TRUSTED_PROXY_HOPS=1
